{
  "title": "engine \u2014 LLM inference server",
  "uid": "engine-overview",
  "description": "Throughput, latency, scheduler behaviour and KV cache utilisation for the engine inference server. Every panel carries a description of what the signal means operationally.",
  "tags": [
    "engine",
    "llm",
    "inference"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "10s",
  "timezone": "browser",
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "label": "Data source",
        "current": {},
        "hide": 0
      },
      {
        "name": "namespace",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "label": "Namespace",
        "query": "label_values(engine_queue_depth, namespace)",
        "refresh": 1,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "multi": false,
        "hide": 0
      },
      {
        "name": "pod",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "label": "Pod",
        "query": "label_values(engine_queue_depth{namespace=~\"$namespace\"}, pod)",
        "refresh": 2,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "multi": true,
        "hide": 0
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Throughput and latency",
      "collapsed": false,
      "gridPos": {
        "w": 24,
        "h": 1,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Tokens/s",
      "description": "Generated tokens per second across all replicas.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "w": 6,
        "h": 4,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(rate(engine_generated_tokens_total{namespace=~\"$namespace\", pod=~\"$pod\"}[$__rate_interval]))",
          "legendFormat": "tokens/s",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Requests in flight",
      "description": "Sequences in the current batch.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "w": 6,
        "h": 4,
        "x": 6,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(engine_running_seqs{namespace=~\"$namespace\", pod=~\"$pod\"})",
          "legendFormat": "running",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Queue depth",
      "description": "Requests waiting for admission. This is the metric KEDA scales on.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "w": 6,
        "h": 4,
        "x": 12,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(engine_queue_depth{namespace=~\"$namespace\", pod=~\"$pod\"})",
          "legendFormat": "waiting",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 4
              },
              {
                "color": "red",
                "value": 16
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "KV waste",
      "description": "Allocated-but-empty KV slots over allocated slots. Paged allocation holds this near half a block per sequence; contiguous allocation would be far higher.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "w": 6,
        "h": 4,
        "x": 18,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "avg(engine_kv_waste_fraction{namespace=~\"$namespace\", pod=~\"$pod\"})",
          "legendFormat": "waste",
          "refId": "D"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [],
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.25
              },
              {
                "color": "red",
                "value": 0.5
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Time to first token",
      "description": "Prefill latency as the client sees it. Rises with queueing and long prompts; prefix cache hits cut it directly.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "w": 12,
        "h": 8,
        "x": 0,
        "y": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.5, sum(rate(engine_ttft_seconds_bucket{namespace=~\"$namespace\", pod=~\"$pod\"}[$__rate_interval])) by (le))",
          "legendFormat": "p50",
          "refId": "E"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.95, sum(rate(engine_ttft_seconds_bucket{namespace=~\"$namespace\", pod=~\"$pod\"}[$__rate_interval])) by (le))",
          "legendFormat": "p95",
          "refId": "F"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.99, sum(rate(engine_ttft_seconds_bucket{namespace=~\"$namespace\", pod=~\"$pod\"}[$__rate_interval])) by (le))",
          "legendFormat": "p99",
          "refId": "G"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
          },
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Inter-token latency",
      "description": "Gap between streamed tokens, i.e. perceived speed. Chunked prefill exists to keep this flat while long prompts are admitted.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "w": 12,
        "h": 8,
        "x": 12,
        "y": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.5, sum(rate(engine_inter_token_seconds_bucket{namespace=~\"$namespace\", pod=~\"$pod\"}[$__rate_interval])) by (le))",
          "legendFormat": "p50",
          "refId": "H"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.95, sum(rate(engine_inter_token_seconds_bucket{namespace=~\"$namespace\", pod=~\"$pod\"}[$__rate_interval])) by (le))",
          "legendFormat": "p95",
          "refId": "I"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.99, sum(rate(engine_inter_token_seconds_bucket{namespace=~\"$namespace\", pod=~\"$pod\"}[$__rate_interval])) by (le))",
          "legendFormat": "p99",
          "refId": "J"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
          },
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 8,
      "type": "row",
      "title": "Scheduler",
      "collapsed": false,
      "gridPos": {
        "w": 24,
        "h": 1,
        "x": 0,
        "y": 13
      },
      "panels": []
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Batch composition",
      "description": "Continuous batching should hold running sequences at the seq limit while work is queued; a growing queue with idle slots means the token budget or KV memory is the binding constraint.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "w": 12,
        "h": 8,
        "x": 0,
        "y": 14
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(engine_running_seqs{namespace=~\"$namespace\", pod=~\"$pod\"})",
          "legendFormat": "running sequences",
          "refId": "K"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(engine_queue_depth{namespace=~\"$namespace\", pod=~\"$pod\"})",
          "legendFormat": "queued requests",
          "refId": "L"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Tokens per forward pass",
      "description": "Prefill chunks plus decode tokens in one step, against max_num_batched_tokens.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "w": 12,
        "h": 8,
        "x": 12,
        "y": 14
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.5, sum(rate(engine_batch_tokens_bucket{namespace=~\"$namespace\", pod=~\"$pod\"}[$__rate_interval])) by (le))",
          "legendFormat": "p50",
          "refId": "M"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.95, sum(rate(engine_batch_tokens_bucket{namespace=~\"$namespace\", pod=~\"$pod\"}[$__rate_interval])) by (le))",
          "legendFormat": "p95",
          "refId": "N"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Step rate and step time",
      "description": "One step is one forward pass. Step time against batch size is where throughput comes from.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "w": 12,
        "h": 8,
        "x": 0,
        "y": 22
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(rate(engine_steps_total{namespace=~\"$namespace\", pod=~\"$pod\"}[$__rate_interval]))",
          "legendFormat": "steps/s",
          "refId": "O"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.95, sum(rate(engine_step_seconds_bucket{namespace=~\"$namespace\", pod=~\"$pod\"}[$__rate_interval])) by (le))",
          "legendFormat": "step p95 (s)",
          "refId": "P"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Preemptions and evictions",
      "description": "Sustained preemptions mean KV memory is oversubscribed: lower max_num_seqs or raise num_blocks. Recomputed tokens are the actual cost, since a preempted sequence loses every token it had computed and must redo them.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "w": 12,
        "h": 8,
        "x": 12,
        "y": 22
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(rate(engine_preemptions_total{namespace=~\"$namespace\", pod=~\"$pod\"}[$__rate_interval]))",
          "legendFormat": "preemptions/s",
          "refId": "Q"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(rate(engine_kv_evictions_total{namespace=~\"$namespace\", pod=~\"$pod\"}[$__rate_interval]))",
          "legendFormat": "KV evictions/s",
          "refId": "R"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(rate(engine_recomputed_tokens_total{namespace=~\"$namespace\", pod=~\"$pod\"}[$__rate_interval]))",
          "legendFormat": "recomputed tokens/s",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 13,
      "type": "row",
      "title": "KV cache",
      "collapsed": false,
      "gridPos": {
        "w": 24,
        "h": 1,
        "x": 0,
        "y": 30
      },
      "panels": []
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Block pool",
      "description": "Used = owned by a running sequence. Cached = refcount zero but retained for prefix reuse; still available capacity, evicted on demand.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "w": 12,
        "h": 8,
        "x": 0,
        "y": 31
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(engine_kv_blocks_used{namespace=~\"$namespace\", pod=~\"$pod\"})",
          "legendFormat": "used",
          "refId": "S"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(engine_kv_blocks_cached{namespace=~\"$namespace\", pod=~\"$pod\"})",
          "legendFormat": "cached (reusable)",
          "refId": "T"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(engine_kv_blocks_free{namespace=~\"$namespace\", pod=~\"$pod\"})",
          "legendFormat": "free",
          "refId": "U"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 60,
            "showPoints": "never",
            "stacking": {
              "mode": "normal"
            }
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "Prefix cache hit ratio",
      "description": "Share of full prompt blocks served from cache. Shared system prompts push this high and cut TTFT.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "w": 12,
        "h": 8,
        "x": 12,
        "y": 31
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(rate(engine_prefix_cache_hit_blocks_total{namespace=~\"$namespace\", pod=~\"$pod\"}[5m])) / clamp_min(sum(rate(engine_prefix_cache_total_blocks_total{namespace=~\"$namespace\", pod=~\"$pod\"}[5m])), 1)",
          "legendFormat": "hit ratio",
          "refId": "V"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
          },
          "unit": "percentunit",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 16,
      "type": "row",
      "title": "Traffic",
      "collapsed": false,
      "gridPos": {
        "w": 24,
        "h": 1,
        "x": 0,
        "y": 39
      },
      "panels": []
    },
    {
      "id": 17,
      "type": "timeseries",
      "title": "Requests",
      "description": "Aborts are client disconnects or drain-time cancellations, not server errors.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "w": 12,
        "h": 8,
        "x": 0,
        "y": 40
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(rate(engine_requests_total{namespace=~\"$namespace\", pod=~\"$pod\"}[$__rate_interval]))",
          "legendFormat": "accepted/s",
          "refId": "W"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(rate(engine_requests_finished_total{namespace=~\"$namespace\", pod=~\"$pod\"}[$__rate_interval]))",
          "legendFormat": "finished/s",
          "refId": "X"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(rate(engine_requests_aborted_total{namespace=~\"$namespace\", pod=~\"$pod\"}[$__rate_interval]))",
          "legendFormat": "aborted/s",
          "refId": "Y"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 18,
      "type": "timeseries",
      "title": "End-to-end request latency",
      "description": "Arrival to completion, so it scales with output length; read it with inter-token latency.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "w": 12,
        "h": 8,
        "x": 12,
        "y": 40
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.5, sum(rate(engine_request_seconds_bucket{namespace=~\"$namespace\", pod=~\"$pod\"}[$__rate_interval])) by (le))",
          "legendFormat": "p50",
          "refId": "Z"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.95, sum(rate(engine_request_seconds_bucket{namespace=~\"$namespace\", pod=~\"$pod\"}[$__rate_interval])) by (le))",
          "legendFormat": "p95",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
          },
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 19,
      "type": "timeseries",
      "title": "Token volume",
      "description": "Prefill versus decode load. The ratio decides whether the workload is prefill- or decode-bound.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "w": 12,
        "h": 8,
        "x": 0,
        "y": 48
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(rate(engine_prompt_tokens_total{namespace=~\"$namespace\", pod=~\"$pod\"}[$__rate_interval]))",
          "legendFormat": "prompt tokens/s",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(rate(engine_generated_tokens_total{namespace=~\"$namespace\", pod=~\"$pod\"}[$__rate_interval]))",
          "legendFormat": "generated tokens/s",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 20,
      "type": "row",
      "title": "Failures and overload",
      "collapsed": false,
      "gridPos": {
        "w": 24,
        "h": 1,
        "x": 0,
        "y": 56
      },
      "panels": []
    },
    {
      "id": 21,
      "type": "timeseries",
      "title": "Rejections and timeouts",
      "description": "Shedding is the correct response to overload, so a little is healthy; sustained shedding means capacity. Queue timeouts are worse than shedding, because the request was accepted first and the client sees a cancelled stream rather than a retryable 429.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "w": 12,
        "h": 8,
        "x": 0,
        "y": 57
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(rate(engine_requests_rejected_overload_total{namespace=~\"$namespace\", pod=~\"$pod\"}[$__rate_interval]))",
          "legendFormat": "shed (429)/s",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(rate(engine_requests_rejected_invalid_total{namespace=~\"$namespace\", pod=~\"$pod\"}[$__rate_interval]))",
          "legendFormat": "invalid (400)/s",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(rate(engine_requests_rejected_draining_total{namespace=~\"$namespace\", pod=~\"$pod\"}[$__rate_interval]))",
          "legendFormat": "draining (503)/s",
          "refId": "C"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(rate(engine_requests_timed_out_total{namespace=~\"$namespace\", pod=~\"$pod\"}[$__rate_interval]))",
          "legendFormat": "queue timeout/s",
          "refId": "D"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 22,
      "type": "timeseries",
      "title": "Recompute waste and health",
      "description": "The share of token work thrown away by preemption, and the allocator's self-check. If accounting drops to zero the pool has leaked or double-counted and nothing measured after that is trustworthy.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "w": 12,
        "h": 8,
        "x": 12,
        "y": 57
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(rate(engine_recomputed_tokens_total{namespace=~\"$namespace\", pod=~\"$pod\"}[$__rate_interval])) / clamp_min(sum(rate(engine_generated_tokens_total{namespace=~\"$namespace\", pod=~\"$pod\"}[$__rate_interval])), 0.001)",
          "legendFormat": "recompute / generated",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "min(engine_kv_accounting_ok{namespace=~\"$namespace\", pod=~\"$pod\"})",
          "legendFormat": "KV accounting ok (1 = sound)",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    }
  ]
}